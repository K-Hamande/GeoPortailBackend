<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <groupId>bf.anptic</groupId>
    <artifactId>geoportail-resina-backend</artifactId>
    <version>1.0.0</version>
    <name>geoportail-resina-backend</name>
    <description>Backend API du Geoportail RESINA pour Decideur (ANPTIC Burkina Faso)</description>

    <properties>
        <java.version>17</java.version>
        <!-- Force UTF-8 pour la lecture des fichiers .java par javac ET
             pour les ressources copiees (application.yaml, etc.).
             SANS CA, Maven se rabat sur l'encodage par defaut de la
             plateforme (variable selon les reglages Windows de chaque
             poste), ce qui corrompt silencieusement tout caractere
             accentue ecrit litteralement dans un fichier .java (ex :
             "Ministère" devient "MinistΦre" a la compilation sur
             certains postes, meme si le fichier source est bien en
             UTF-8 sur le disque) - exactement le probleme observe chez
             un collegue sur /historique/... des sites RESINA.
             chcp 65001 dans PowerShell ne corrige PAS ce probleme :
             ca ne change que l'affichage dans le terminal, pas la
             maniere dont javac lit les fichiers source pendant la
             compilation. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>


        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <dependency>
    <groupId>io.jsonwebtoken</groupId>
    <artifactId>jjwt-api</artifactId>
    <version>0.11.5</version>
</dependency>
<dependency>
    <groupId>io.jsonwebtoken</groupId>
    <artifactId>jjwt-impl</artifactId>
    <version>0.11.5</version>
    <scope>runtime</scope>
</dependency>
<dependency>
    <groupId>io.jsonwebtoken</groupId>
    <artifactId>jjwt-jackson</artifactId>
    <version>0.11.5</version>
    <scope>runtime</scope>
</dependency>

<!-- Notifications push (Web Push standard : VAPID + chiffrement RFC 8291),
     voir service.PushNotificationService. web-push utilise des classes
     BouncyCastle (ECPublicKey) sans les declarer comme dependance Maven -
     bcprov-jdk18on est donc necessaire ici explicitement, sinon erreur de
     compilation/NoClassDefFoundError au runtime. -->
<dependency>
    <groupId>nl.martijndwars</groupId>
    <artifactId>web-push</artifactId>
    <version>5.1.1</version>
</dependency>
<dependency>
    <groupId>org.bouncycastle</groupId>
    <artifactId>bcprov-jdk18on</artifactId>
    <version>1.78.1</version>
</dependency>

    </dependencies>



    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>